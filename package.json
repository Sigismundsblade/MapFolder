{
  "name": "mapfolder",
  "version": "0.1.0",
  "description": "Local file relationship visualizer for Python, JavaScript, TypeScript, and Java",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsc --watch"
  },
  "keywords": [
    "dependency-graph",
    "codebase-visualizer",
    "static-analysis",
    "typescript",
